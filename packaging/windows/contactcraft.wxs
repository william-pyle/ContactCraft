<?xml version="1.0" encoding="utf-8"?>
<!--
  ContactCraft MSI (WiX Toolset v5, with its UI and Util extensions), built by package.ps1:

    wix build contactcraft.wxs -arch x64 -ext WixToolset.UI.wixext -ext WixToolset.Util.wixext
      -d Version=1.2.3 -d BinDir=... -d IconPath=... -d LicenseRtf=... -o out.msi

  Like MailCraft's and MessageCraft's installers: per-machine install into Program Files, a Start
  Menu shortcut, and the standard WiX dialogs (welcome + licence, progress, finish with
  "Launch ContactCraft"). A newer installer replaces the installed version in place; the contacts
  in %APPDATA%\ContactCraft are never touched by installing, updating or uninstalling.

  The UpgradeCode and component GUIDs below are ContactCraft's own. Never share them with another
  app: Windows Installer treats every package with one UpgradeCode as the same product.
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs" xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui">
  <Package
      Name="ContactCraft"
      Manufacturer="ContactCraft contributors"
      Version="$(var.Version)"
      UpgradeCode="9CC84440-9F4C-4EBB-BCCC-468A2E210F25"
      Scope="perMachine"
      Compressed="yes"
      Language="1033">
    <SummaryInformation Description="ContactCraft: your contacts on Windows, shared with every Craft app" Manufacturer="ContactCraft contributors" />
    <MajorUpgrade AllowDowngrades="yes" />
    <MediaTemplate EmbedCab="yes" CompressionLevel="high" />

    <Icon Id="ContactCraftIcon.ico" SourceFile="$(var.IconPath)" />
    <Property Id="ARPPRODUCTICON" Value="ContactCraftIcon.ico" />
    <Property Id="ARPURLINFOABOUT" Value="https://github.com/william-pyle/ContactCraft" />
    <Property Id="ARPURLUPDATEINFO" Value="https://github.com/william-pyle/ContactCraft/releases" />
    <Property Id="ARPHELPLINK" Value="https://github.com/william-pyle/ContactCraft/issues" />

    <WixVariable Id="WixUILicenseRtf" Value="$(var.LicenseRtf)" />
    <Property Id="WIXUI_EXITDIALOGOPTIONALCHECKBOXTEXT" Value="Launch ContactCraft" />
    <Property Id="WIXUI_EXITDIALOGOPTIONALCHECKBOX" Value="1" />
    <Property Id="WixShellExecTarget" Value="[#ContactCraftExe]" />
    <CustomAction Id="LaunchContactCraft" BinaryRef="Wix4UtilCA_$(sys.BUILDARCHSHORT)" DllEntry="WixShellExec"
        Impersonate="yes" Return="ignore" />
    <UI>
      <ui:WixUI Id="WixUI_Minimal" />
      <Publish Dialog="ExitDialog" Control="Finish" Event="DoAction" Value="LaunchContactCraft"
          Condition="WIXUI_EXITDIALOGOPTIONALCHECKBOX = 1 AND NOT Installed" />
    </UI>

    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLFOLDER" Name="ContactCraft">
        <Component Id="ContactCraftExe" Guid="ED630607-7DE9-48BB-9F5D-17892526826D">
          <File Id="ContactCraftExe" Source="$(var.BinDir)\ContactCraft.exe" KeyPath="yes" />
          <File Id="NoticeMd" Source="$(var.BinDir)\NOTICE.md" />
          <File Id="SharedContactsMd" Source="$(var.BinDir)\shared-contacts.md" />
          <File Id="AiInstructionsMd" Source="$(var.BinDir)\messagecraft-ai-instructions.md" />
        </Component>
      </Directory>
    </StandardDirectory>

    <StandardDirectory Id="ProgramMenuFolder">
      <Component Id="StartMenuShortcut" Guid="3BE2D45A-0AA5-4C97-A86B-F8B9D46616C0">
        <Shortcut Id="ContactCraftShortcut"
            Name="ContactCraft"
            Description="Your contacts on Windows, shared with every Craft app"
            Target="[#ContactCraftExe]"
            WorkingDirectory="INSTALLFOLDER"
            Icon="ContactCraftIcon.ico" />
        <RegistryValue Root="HKLM" Key="Software\ContactCraft" Name="StartMenuShortcut" Type="integer" Value="1" KeyPath="yes" />
      </Component>
    </StandardDirectory>

    <Feature Id="Main" Title="ContactCraft" Level="1">
      <ComponentRef Id="ContactCraftExe" />
      <ComponentRef Id="StartMenuShortcut" />
    </Feature>
  </Package>
</Wix>
